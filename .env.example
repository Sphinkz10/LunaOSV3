# LUNA.OS — variáveis de ambiente (copiar para .env e preencher)
# Obter em: Supabase Dashboard → Settings → API

# URL do projeto (ex.: https://abcdefgh.supabase.co)
VITE_SUPABASE_URL=

# Chave anon/public — NUNCA usar service_role aqui
VITE_SUPABASE_ANON_KEY=

# Opcional — observabilidade (P2.9)
# VITE_SENTRY_DSN=
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Endereço da app do cliente (ligações de convite e QR), ex.: https://cliente.lunaos.pt
# VITE_ATHLETE_URL=
